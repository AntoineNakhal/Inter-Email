APP_ENV=local

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=5173
FRONTEND_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# SQLite (local dev default)
# DATABASE_URL=sqlite:///./data/sqlite/app.db
# Postgres (selfhost — matches docker-compose.selfhost.yml credentials)
# DATABASE_URL=postgresql+psycopg://interemailv3:interemailv3@localhost:5432/interemailv3

# Redis — leave empty for local dev (BackgroundTasks fallback).
# Set to redis://redis:6379 when running via docker-compose.
REDIS_URL=
CACHE_DIR=./data/cache
EXPORT_DIR=./data/exports

GMAIL_CREDENTIALS_PATH=./data/raw/google_credentials.json
GMAIL_TOKEN_DIR=./data/raw/gmail_tokens
GMAIL_MAX_RESULTS=50
GMAIL_THREAD_SOURCE=anywhere

# Gmail Pub/Sub push notifications (optional — leave empty to use polling only).
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# Outlook / Microsoft 365 OAuth
# Register your app at https://portal.azure.com → App registrations
# Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=common

# Auth
# AUTH_ALLOWED_EMAILS: optional comma-separated allowlist (leave empty = anyone can register)
# AUTH_ADMIN_EMAILS: comma-separated list of emails that get the admin role on register
AUTH_ALLOWED_EMAILS=
AUTH_ADMIN_EMAILS=a.nakhal@inter-op.ca
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-or-random-secret
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

AI_DEFAULT_PROVIDER=openai
AI_THREAD_ANALYSIS_PROVIDER=openai
AI_QUEUE_SUMMARY_PROVIDER=openai
AI_DRAFT_PROVIDER=openai
AI_CRM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL_THREAD_ANALYSIS=gpt-4.1-mini
OPENAI_MODEL_QUEUE_SUMMARY=gpt-4.1-mini
OPENAI_MODEL_DRAFT=gpt-4.1
OPENAI_MODEL_CRM=gpt-4.1-mini

ANTHROPIC_API_KEY=
# Haiku is strongly recommended for cost efficiency on all tasks.
# Use claude-sonnet-4-6 only for draft_reply if you need higher quality replies.
ANTHROPIC_MODEL_THREAD_ANALYSIS=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_QUEUE_SUMMARY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DRAFT=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CRM=claude-haiku-4-5-20251001

# For direct local Ollama outside Docker:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_THREAD_ANALYSIS=gemma4:e4b
OLLAMA_MODEL_QUEUE_SUMMARY=gemma4:e4b
OLLAMA_MODEL_DRAFT=gemma4:e4b
OLLAMA_MODEL_CRM=gemma4:e4b
