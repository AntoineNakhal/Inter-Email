  "components": {
    "schemas": {
      "SyncRequest": {
        "type": "object",
        "title": "SyncRequest",
        "properties": {
          "source": { "type": "string", "title": "Source", "default": "anywhere" },
          "max_results": { "type": "integer", "title": "Max Results", "default": 50 },
          "lookback_days": { "type": "integer", "title": "Lookback Days", "default": 7, "minimum": 1, "maximum": 365 }
        }
      },
      "SyncStatusResponse": {
        "type": "object",
        "title": "SyncStatusResponse",
        "required": ["run_id", "status", "source", "stage", "progress_percent", "stage_unit_current", "stage_unit_total", "status_message", "fetched_message_count", "thread_count", "ai_thread_count"],
        "properties": {
          "run_id": { "type": "integer", "title": "Run Id" },
          "status": { "type": "string", "title": "Status" },
          "source": { "type": "string", "title": "Source" },
          "stage": { "type": "string", "title": "Stage" },
          "progress_percent": { "type": "integer", "title": "Progress Percent" },
          "stage_unit_current": { "type": "integer", "title": "Stage Unit Current" },
          "stage_unit_total": { "type": "integer", "title": "Stage Unit Total" },
          "eta_seconds": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Eta Seconds" },
          "status_message": { "type": "string", "title": "Status Message" },
          "fetched_message_count": { "type": "integer", "title": "Fetched Message Count" },
          "thread_count": { "type": "integer", "title": "Thread Count" },
          "ai_thread_count": { "type": "integer", "title": "Ai Thread Count" },
          "cancellation_requested": { "type": "boolean", "title": "Cancellation Requested", "default": false },
          "completed_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Completed At" },
          "queue_summary": { "anyOf": [{ "$ref": "#/components/schemas/QueueSummaryResponse" }, { "type": "null" }] },
          "error_message": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Error Message" }
        }
      },
      "ThreadListResponse": {
        "type": "object",
        "title": "ThreadListResponse",
        "properties": {
          "threads": { "type": "array", "items": { "$ref": "#/components/schemas/ThreadResponse" }, "title": "Threads" }
        }
      },
      "ThreadResponse": {
        "type": "object",
        "title": "ThreadResponse",
        "required": ["thread_id", "subject", "message_count", "security_status", "waiting_on_us", "resolved_or_closed", "included_in_ai", "analysis_status", "signature"],
        "properties": {
          "thread_id": { "type": "string", "title": "Thread Id" },
          "subject": { "type": "string", "title": "Subject" },
          "participants": { "type": "array", "items": { "type": "string" }, "title": "Participants" },
          "message_count": { "type": "integer", "title": "Message Count" },
          "latest_message_date": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Latest Message Date" },
          "security_status": { "type": "string", "title": "Security Status" },
          "sensitivity_markers": { "type": "array", "items": { "type": "string" }, "title": "Sensitivity Markers" },
          "waiting_on_us": { "type": "boolean", "title": "Waiting On Us" },
          "resolved_or_closed": { "type": "boolean", "title": "Resolved Or Closed" },
          "relevance_score": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "title": "Relevance Score" },
          "relevance_bucket": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Relevance Bucket" },
          "included_in_ai": { "type": "boolean", "title": "Included In Ai" },
          "ai_decision": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Ai Decision" },
          "ai_decision_reason": { "anyOf": [{ "type": "string" }, { "type": "null" }], "title": "Ai Decision Reason" },
          "analysis_status": { "type": "string", "title": "Analysis Status" },
          "signature": { "type": "string", "title": "Signature" },
          "is_new": { "type": "boolean", "title": "Is New", "default": false },
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/ThreadMessageResponse" }, "title": "Messages" },
          "analysis": { "anyOf": [{ "$ref": "#/components/schemas/ThreadAnalysisResponse" }, { "type": "null" }] },
          "seen_state": { "anyOf": [{ "$ref": "#/components/schemas/SeenStateResponse" }, { "type": "null" }] },
          "review": { "anyOf": [{ "$ref": "#/components/schemas/ReviewDecisionResponse" }, { "type": "null" }] },
          "latest_draft": { "anyOf": [{ "$ref": "#/components/schemas/DraftResponse" }, { "type": "null" }] }
        }
      },
      "ThreadMessageResponse": {
        "type": "object",
        "title": "ThreadMessageResponse",
        "required": ["message_id", "sender", "subject"],
        "properties": {
          "message_id": { "type": "string", "title": "Message Id" },
          "sender": { "type": "string", "title": "Sender" },
          "recipients": { "type": "array", "items": { "type": "string" }, "title": "Recipients" },
          "subject": { "type": "string", "title": "Subject" },
          "sent_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Sent At" },
          "snippet": { "type": "string", "title": "Snippet", "default": "" },
          "cleaned_body": { "type": "string", "title": "Cleaned Body", "default": "" },
          "is_forwarded": { "type": "boolean", "title": "Is Forwarded", "default": false }
        }
      },
      "ThreadAnalysisResponse": {
        "type": "object",
        "title": "ThreadAnalysisResponse",
        "required": ["category", "urgency", "summary", "current_status", "next_action", "needs_next_action", "needs_action_today", "should_draft_reply", "draft_needs_date", "draft_needs_attachment", "provider_name", "model_name", "used_fallback", "accuracy_percent", "verification_summary", "needs_human_review", "verifier_provider_name", "verifier_model_name", "verifier_used_fallback"],
        "properties": {
          "category": { "type": "string", "title": "Category" },
          "urgency": { "type": "string", "title": "Urgency" },
